# --- Database ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/optizm?schema=public"

# --- NextAuth ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Microsoft Graph / Outlook integration (optional — leave blank to disable) ---
# Set up an app registration at https://portal.azure.com (Azure AD > App registrations).
# Redirect URI: {NEXTAUTH_URL}/api/integrations/microsoft/callback
# Required delegated Graph API permissions: Mail.Read, Mail.Send, Calendars.Read, offline_access, User.Read
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""
MICROSOFT_TENANT_ID="common"

# --- AI résumé parsing (optional — leave blank to fall back to manual entry) ---
# Uses the Anthropic API (Claude) to extract structured fields from résumé text.
ANTHROPIC_API_KEY=""
