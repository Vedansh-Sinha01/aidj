# Spotify Developer Dashboard (developer.spotify.com/dashboard)
# Create an app, then paste its Client ID here. Set the redirect URI in the
# dashboard to exactly: http://127.0.0.1:3000/callback
SPOTIFY_CLIENT_ID=

# Anthropic Console (console.anthropic.com) API key
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-sonnet-5
# PORT=3000
